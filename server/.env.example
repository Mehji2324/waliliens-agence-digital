# ─────────────────────────────────────────────────────────────────────────────
# Waliliens — Backend Environment Configuration
# Copy this file to .env and fill in every value marked REQUIRED for production.
# See server/docs/PRODUCTION_CHECKLIST.md for step-by-step instructions.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────

# HTTP port the Express server listens on.
PORT=4000

# Runtime environment: development | production | test
# In production this MUST be set to "production" to enable all security guards.
NODE_ENV=production

# Public URL of the frontend (used for CORS whitelist and CSRF checks).
# REQUIRED in production. Example: https://waliliens.com
CLIENT_URL=http://localhost:5173

# Set to "true" if the server runs behind an Nginx/load-balancer reverse proxy.
# Enables Express trust proxy so rate limiting uses the real client IP.
TRUST_PROXY=false

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# REQUIRED in production.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waliliens

# ── Rate Limiting ─────────────────────────────────────────────────────────────

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# ── Admin Authentication ──────────────────────────────────────────────────────
# REQUIRED in production. All three variables must be set.

# Email address used to log in to the admin dashboard.
ADMIN_EMAIL=admin@yourdomain.com

# bcrypt hash of the admin password. Generate one with:
#   npm run admin:hash -- "YourSecurePassword!"
# Never paste a real hash here — this file is committed to version control.
ADMIN_PASSWORD_HASH=

# Secret used to sign JWT session tokens. Minimum 32 characters.
# Generate a strong secret with:
#   openssl rand -base64 48
# Never use this placeholder in production.
SESSION_SECRET=

# ── Google Calendar Integration ───────────────────────────────────────────────
# Set GOOGLE_CALENDAR_ENABLED=true only when all three credential variables are
# populated. If enabled in production without credentials, the server will refuse
# to start. See server/docs/GOOGLE_CALENDAR_SETUP.md for OAuth setup steps.

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar to use for booking events. "primary" uses the account's default calendar.
GOOGLE_CALENDAR_ID=primary

# ── Booking Rules & Working Hours ─────────────────────────────────────────────

BOOKING_DURATION_MINUTES=30
# IANA timezone identifier. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BOOKING_TIMEZONE=Africa/Casablanca
BOOKING_START_HOUR=10
BOOKING_END_HOUR=18
# Minimum minutes of advance notice required before a slot can be booked.
BOOKING_MIN_NOTICE_MINUTES=120

# ── Email Notifications (Resend) ──────────────────────────────────────────────
# Set EMAIL_ENABLED=true only when RESEND_API_KEY is populated.
# If enabled without the key, the server will refuse to start in production.
# See server/docs/EMAIL_SETUP.md for Resend domain verification steps (SPF/DKIM).

EMAIL_ENABLED=false

# Resend API key. Obtain from https://resend.com/api-keys
# Use a "Sending access" key scoped to your verified domain.
RESEND_API_KEY=

# "From" address shown in email headers. Must match your verified Resend domain.
EMAIL_FROM=Waliliens <hello@yourdomain.com>

# Internal team inbox that receives booking notifications.
BOOKING_NOTIFICATION_EMAIL=waliliens.ai@gmail.com
