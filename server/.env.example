# Waliliens — Backend Environment Configuration

# HTTP server port
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# Frontend origin for CORS whitelist
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waliliens

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10

# Google Calendar Integration (Phase 5)
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary

# Booking Rules & Working Hours
BOOKING_DURATION_MINUTES=30
BOOKING_TIMEZONE=Africa/Casablanca
BOOKING_START_HOUR=10
BOOKING_END_HOUR=18
BOOKING_MIN_NOTICE_MINUTES=120

# Email Notifications (Phase 6 - Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Waliliens <hello@yourdomain.com>
BOOKING_NOTIFICATION_EMAIL=team@yourdomain.com
EMAIL_ENABLED=false

# Admin Authentication & Studio Dashboard (Phase 7)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$10$wK52r1r7jVl0n5h5u1P4O.Wp6rL3o9f2z7m5y1v8x0t4u3q2s1a9e
SESSION_SECRET=your_super_secret_session_key_for_signing_jwt_cookies
