# Waliliens — Backend Environment Configuration

# HTTP server port
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# Frontend origin for CORS whitelist
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/waliliens

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10

# Google Calendar Integration (Phase 5)
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_CALENDAR_ID=primary

# Booking Rules & Working Hours
BOOKING_DURATION_MINUTES=30
BOOKING_TIMEZONE=Africa/Casablanca
BOOKING_START_HOUR=10
BOOKING_END_HOUR=18
BOOKING_MIN_NOTICE_MINUTES=120
