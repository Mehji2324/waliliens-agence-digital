# ─────────────────────────────────────────────────────────────────────────────
# Waliliens — Frontend Environment Configuration
# Copy this file to .env and adjust for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=waliliens
POSTGRES_USER=waliliens_app
# Required by docker-compose.yml. Generate a unique value with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── API URL ───────────────────────────────────────────────────────────────────
# Development: leave empty. The Vite dev server proxy (vite.config.ts) forwards
# all /api/* requests to http://localhost:4000 automatically — no CORS issues.
#
# Production (same domain via Nginx): leave empty or set to "" so requests go
# to /api/... on the same origin. Nginx proxies /api/* to the backend.
#
# Production (separate subdomain, e.g. api.waliliens.com): set the full origin:
#   VITE_API_URL=https://api.waliliens.com
#
# NOTE: Endpoint paths already include /api (e.g. /api/contact), so do NOT
# set VITE_API_URL=/api — that would produce /api/api/... double-prefix URLs.
VITE_API_URL=

# ── Mock API ──────────────────────────────────────────────────────────────────
# Enable local mock data fallback for projects and services when the backend is
# unreachable (development only). Must be "true" to activate — any other value
# (including absent) disables it. Never set this in production builds.
VITE_ENABLE_MOCK_API=false

# ── Optional ──────────────────────────────────────────────────────────────────
# Optional Sentry performance/error diagnostics; only initialized after consent.
VITE_SENTRY_DSN=

# Reserved for future telemetry integration.
VITE_TELEMETRY_KEY=
