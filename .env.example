# Waliliens Frontend Environment Configuration

# Docker Compose PostgreSQL (required by docker-compose.yml)
POSTGRES_DB=waliliens
POSTGRES_USER=waliliens_app
# Generate a unique value with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Backend API Base URL
VITE_API_URL=http://localhost:4000

# Enable mock API fallback in development if server is unreachable (true/false)
VITE_ENABLE_MOCK_API=true

# Future Analytics / Telemetry key (optional)
VITE_TELEMETRY_KEY=
